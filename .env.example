# Copie para .env na raiz; use apenas a sua conta. Não faça commit de .env.
OCI_CONFIG_FILE=/absolute/path/to/your/.oci/config
OCI_PROFILE=DEFAULT
AIDP_ENDPOINT=https://REPLACE_WITH_YOUR_AIDP_ENDPOINT
AIDP_OCID=REPLACE_WITH_YOUR_INSTANCE_OCID
AIDP_WORKSPACE_KEY=REPLACE_WITH_YOUR_WORKSPACE_KEY
COURTROOM_PORT=4178
